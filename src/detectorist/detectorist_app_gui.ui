        <item>
         <widget class="QGroupBox" name="crop_info_group_box">
          <property name="title">
           <string>Crop (Export)</string>
          </property>
          <layout class="QGridLayout" name="grdlyt_crop">
           <item row="0" column="0" colspan="2">
            <widget class="QRadioButton" name="rb_crop_all_detected_objects">
             <property name="focusPolicy">
              <enum>Qt::FocusPolicy::TabFocus</enum>
             </property>
             <property name="toolTip">
              <string>Crops all detected objects into individual images</string>
             </property>
