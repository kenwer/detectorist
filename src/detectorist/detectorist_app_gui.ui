             <property name="text">
              <string>Most confident detection</string>
             </property>
             <property name="checked">
              <bool>false</bool>
             </property>
             <attribute name="buttonGroup">
              <string notr="true">btngroup_crop</string>
             </attribute>
            </widget>
           </item>
           <item row="2" column="0" colspan="2">
            <widget class="QRadioButton" name="rb_crop_best_classification">
             <property name="focusPolicy">
              <enum>Qt::FocusPolicy::TabFocus</enum>
             </property>
             <property name="toolTip">
              <string>Crops only the best classified object into a new image: the deepest identified rank wins, then the highest score</string>
             </property>
             <property name="text">
              <string>Best classification</string>
             </property>
             <property name="checked">
              <bool>false</bool>
             </property>
             <attribute name="buttonGroup">
              <string notr="true">btngroup_crop</string>
             </attribute>
            </widget>
           </item>
           <item row="3" column="0" colspan="2">
            <widget class="QRadioButton" name="rb_crop_centered_obj">
             <property name="focusPolicy">
              <enum>Qt::FocusPolicy::TabFocus</enum>
             </property>
             <property name="toolTip">
              <string>Crops to the most centrally located of all detected objects only into a new image</string>
