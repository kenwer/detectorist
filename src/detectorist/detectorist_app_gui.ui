             </attribute>
            </widget>
           </item>
           <item row="1" column="0" colspan="2">
            <widget class="QRadioButton" name="rb_crop_most_confident_detection">
             <property name="focusPolicy">
              <enum>Qt::FocusPolicy::TabFocus</enum>
             </property>
             <property name="toolTip">
              <string>Crops only the detection the object detector is most confident about into a new image</string>
