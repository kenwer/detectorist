# Top level is an allow list: tool state, scratch patches and notes that
# appear in the repo root stay untracked until they are listed here.
/*
!/.gitattributes
!/.githooks/
!/.github/
!/.gitignore
!/CHANGELOG.md
!/CITATION.cff
!/DEVELOPMENT.md
!/FAQ.md
!/LICENSE
!/README.md
!/assets/
!/benchmarks/
!/docs/
!/models/
!/pyproject.toml
!/scripts/
!/src/
!/tests/
!/uv.lock

# Python-specific ignores
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
build/

# Egg-info directories 
*.egg-info/
**/*.egg-info/
*.egg

# Project specific ignores
dist/

# IDE-specific files
.vscode/
.idea/

# Miscellaneous
**/*.patch
*.log
.DS_Store
*.csv
*.md
!README.md
!CHANGELOG.md
!DEVELOPMENT.md
!FAQ.md

# PyQt/PySide generated files
ui_*.py
*_rc.py

# Generated by scripts/build_poster.py
docs/poster/poster.pdf
docs/poster/poster_preview_*.png
docs/poster/qr.png
docs/poster/screenshot.jpg
